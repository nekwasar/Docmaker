{
  "expo": {
    "name": "Docmaker",
    "slug": "docmaker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "docmaker",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.docmaker.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.docmaker.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Docmaker to access your camera for document scanning"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Docmaker to access your photos for document upload"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
