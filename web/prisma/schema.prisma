generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  googleId      String?
  role          String    @default("free") // free, pro, admin
  credits       Int       @default(0)
  usedCredits   Int       @default(0)
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents     Document[]
  refreshTokens RefreshToken[]
  payments      Payment[]
  subscriptions Subscription[]
  transfers     Transfer[]
  templates     Template[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   Json     // Structured document content
  format    String   @default("pdf")
  wordCount Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User         @relation(fields: [userId], references: [id])
  versions   DocumentVersion[]
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  content    Json
  trigger    String   // generation, edit, manual
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal
  currency  String   @default("usd")
  status    String   // pending, completed, failed, refunded
  provider  String   // stripe, flutterwave, paystack, paypal
  externalId String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String   // monthly, yearly
  status    String   // active, canceled, past_due
  credits   Int
  currentPeriodEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Transfer {
  id              String   @id @default(cuid())
  senderId        String
  code            String   @unique
  fileName        String
  fileSize        Int
  fileMimeType    String   @default("application/octet-stream")
  fileHash        String
  encryptedKey    String
  status          String   @default("pending") // pending, active, completed, expired, deleted
  maxDownloads    Int      @default(1)
  downloadCount   Int      @default(0)
  retentionDays   Int      @default(1)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  sender          User     @relation(fields: [senderId], references: [id])
  chunks          TransferChunk[]
}

model TransferChunk {
  id              String   @id @default(cuid())
  transferId      String
  chunkIndex      Int
  filePath        String
  createdAt       DateTime @default(now())

  transfer        Transfer @relation(fields: [transferId], references: [id])
}

model Template {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String   @default("")
  category        String   // invoice, report, contract, business, personal, academic, etc.
  prompt          String   @default("") // template prompt / extracted content
  content         String?  @db.Text // full markdown / extracted text for file templates
  author          String?  // display author, e.g. "Olivia Wilson"
  thumbnails      Json?    // string[] of image urls
  fileUrl         String?  // /uploads/templates/<id>.pdf etc
  fileName        String?  // original filename
  fileSize        Int?
  isPublic        Boolean  @default(true)
  downloads       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])
}

model AdminSetting {
  key            String   @id
  encryptedValue String   @db.Text
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

model ApiUsageLog {
  id               String   @id @default(cuid())
  provider         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Decimal  @db.Decimal(10, 6) @default(0)
  userId           String?
  sessionId        String?
  path             String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  userId    String?
  ip        String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([sessionId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?
  status    String   @default("subscribed") // subscribed, unsubscribed
  createdAt DateTime @default(now())

  @@index([status])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
}
